# Copy to .env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=itiinspection.hp.gov.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://itiinspection.hp.gov.in
DJANGO_HTTPS=1

